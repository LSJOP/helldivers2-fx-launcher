diff --git a/pkg/services/forwarder/udp_mapping_darwin_test.go b/pkg/services/forwarder/udp_mapping_darwin_test.go
new file mode 100644
index 0000000..cd669f7
--- /dev/null
+++ b/pkg/services/forwarder/udp_mapping_darwin_test.go
@@ -0,0 +1,144 @@
+package forwarder
+
+import (
+	"fmt"
+	"net"
+	"sync"
+	"testing"
+	"time"
+)
+
+func echoUDP(t *testing.T) string {
+	t.Helper()
+	c, err := net.ListenUDP("udp4", &net.UDPAddr{IP: net.IPv4(127, 0, 0, 1)})
+	if err != nil {
+		t.Fatal(err)
+	}
+	t.Cleanup(func() { c.Close() })
+	go func() {
+		b := make([]byte, 4096)
+		for {
+			n, a, err := c.ReadFromUDP(b)
+			if err != nil {
+				return
+			}
+			c.WriteToUDP(b[:n], a)
+		}
+	}()
+	return c.LocalAddr().String()
+}
+
+func checkEcho(c net.Conn, payload string) error {
+	c.SetDeadline(time.Now().Add(3 * time.Second))
+	if _, err := c.Write([]byte(payload)); err != nil {
+		return err
+	}
+	b := make([]byte, 4096)
+	n, err := c.Read(b)
+	if err != nil {
+		return err
+	}
+	if string(b[:n]) != payload {
+		return fmt.Errorf("wrong reply: %q", b[:n])
+	}
+	return nil
+}
+
+func TestUDPPortMapping(t *testing.T) {
+	t.Setenv("GVPROXY_UDP_PORT_MAPPING", "endpoint-independent")
+	dial := newUDPSessionDialer()
+	a, b := echoUDP(t), echoUDP(t)
+	c1, err := dial("guest:1234", a)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c1.Close()
+	c2, err := dial("guest:1234", b)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c2.Close()
+	c3, err := dial("guest:5678", a)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c3.Close()
+	if c1.LocalAddr().String() != c2.LocalAddr().String() {
+		t.Fatal("source port changed across destinations")
+	}
+	if c1.LocalAddr().String() == c3.LocalAddr().String() {
+		t.Fatal("different guest sources share a binding")
+	}
+	for i, c := range []net.Conn{c1, c2, c3} {
+		if err := checkEcho(c, fmt.Sprint(i)); err != nil {
+			t.Fatal(err)
+		}
+	}
+}
+
+func TestUDPPortMappingConcurrentAndRelease(t *testing.T) {
+	m := &udpPortMappings{bindings: make(map[string]*udpPortBinding)}
+	const count = 32
+	destinations := make([]string, count)
+	conns := make([]net.Conn, count)
+	for i := range destinations {
+		destinations[i] = echoUDP(t)
+	}
+	var wg sync.WaitGroup
+	for i := range destinations {
+		wg.Add(1)
+		go func(i int) {
+			defer wg.Done()
+			c, err := m.dial("guest:1111", destinations[i])
+			if err != nil {
+				t.Error(err)
+				return
+			}
+			conns[i] = c
+			if err := checkEcho(c, fmt.Sprint(i)); err != nil {
+				t.Error(err)
+			}
+		}(i)
+	}
+	wg.Wait()
+	port := 0
+	for _, c := range conns {
+		if c == nil {
+			continue
+		}
+		p := c.LocalAddr().(*net.UDPAddr).Port
+		if port != 0 && p != port {
+			t.Error("port changed during concurrent dials")
+		}
+		port = p
+	}
+	for _, c := range conns {
+		if c != nil {
+			c.Close()
+			c.Close()
+		}
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	if len(m.bindings) != 0 {
+		t.Fatal("closed bindings retained")
+	}
+}
+
+func TestUDPPortMappingDefaultUnchanged(t *testing.T) {
+	t.Setenv("GVPROXY_UDP_PORT_MAPPING", "")
+	dial := newUDPSessionDialer()
+	c1, err := dial("guest:1234", echoUDP(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c1.Close()
+	c2, err := dial("guest:1234", echoUDP(t))
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer c2.Close()
+	if c1.LocalAddr().String() == c2.LocalAddr().String() {
+		t.Fatal("opt-in unexpectedly active by default")
+	}
+}
