diff --git a/pkg/services/forwarder/udp_mapping_darwin.go b/pkg/services/forwarder/udp_mapping_darwin.go
new file mode 100644
index 0000000..d41b9ba
--- /dev/null
+++ b/pkg/services/forwarder/udp_mapping_darwin.go
@@ -0,0 +1,90 @@
+package forwarder
+
+import (
+	"net"
+	"os"
+	"sync"
+	"syscall"
+
+	log "github.com/sirupsen/logrus"
+	"golang.org/x/sys/unix"
+)
+
+// Preserve one host source port per guest source endpoint across destinations.
+// Connected UDP sockets retain the existing remote-address filtering.
+func newUDPSessionDialer() func(string, string) (net.Conn, error) {
+	if os.Getenv("GVPROXY_UDP_PORT_MAPPING") != "endpoint-independent" {
+		return func(_ string, destination string) (net.Conn, error) { return net.Dial("udp", destination) }
+	}
+	log.Info("UDP endpoint-independent source port mapping enabled")
+	m := &udpPortMappings{bindings: make(map[string]*udpPortBinding)}
+	return m.dial
+}
+
+type udpPortBinding struct{ port, refs int }
+type udpPortMappings struct {
+	mu       sync.Mutex
+	bindings map[string]*udpPortBinding
+}
+
+func (m *udpPortMappings) dial(source, destination string) (net.Conn, error) {
+	address, err := net.ResolveUDPAddr("udp", destination)
+	if err != nil {
+		return nil, err
+	}
+	if address.IP.To4() == nil {
+		return net.Dial("udp", destination)
+	}
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	binding := m.bindings[source]
+	port := 0
+	if binding != nil {
+		port = binding.port
+	}
+	d := net.Dialer{
+		LocalAddr: &net.UDPAddr{IP: net.IPv4zero, Port: port},
+		Control: func(_, _ string, raw syscall.RawConn) error {
+			var optionErr error
+			err := raw.Control(func(fd uintptr) {
+				optionErr = unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSEADDR, 1)
+				if optionErr == nil {
+					optionErr = unix.SetsockoptInt(int(fd), unix.SOL_SOCKET, unix.SO_REUSEPORT, 1)
+				}
+			})
+			if err != nil {
+				return err
+			}
+			return optionErr
+		},
+	}
+	conn, err := d.Dial("udp4", address.String())
+	if err != nil {
+		return nil, err
+	}
+	if binding == nil {
+		binding = &udpPortBinding{port: conn.LocalAddr().(*net.UDPAddr).Port}
+		m.bindings[source] = binding
+	}
+	binding.refs++
+	return &mappedUDPConn{Conn: conn, release: func() {
+		m.mu.Lock()
+		defer m.mu.Unlock()
+		binding.refs--
+		if binding.refs == 0 {
+			delete(m.bindings, source)
+		}
+	}}, nil
+}
+
+type mappedUDPConn struct {
+	net.Conn
+	once     sync.Once
+	release  func()
+	closeErr error
+}
+
+func (c *mappedUDPConn) Close() error {
+	c.once.Do(func() { c.closeErr = c.Conn.Close(); c.release() })
+	return c.closeErr
+}
